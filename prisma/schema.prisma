generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  events        Event[]
  sessions      Session[]
}

model Event {
  id            String    @id @default(cuid())
  type          EventType
  name          String
  honoreeName   String?
  date          DateTime
  location      String
  description   String?
  coverImageUrl String?
  slug          String    @unique
  creatorId     String
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  locationURL   String    @default("")
  birthdayAge   Int?
  dressCode     String?
  gender        Gender?
  endDate       DateTime?
  timezone      String?
  creator       User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  gifts         Gift[]
  messages      EventMessage[]

  @@index([creatorId])
  @@index([slug])
}

model Gift {
  id                String     @id @default(cuid())
  eventId           String
  name              String
  imageUrl          String?
  brand             String?
  price             Decimal?   @db.Decimal(10, 2)
  currency          String     @default("PEN")
  description       String?
  color             String?
  size              String?
  dimensions        String?
  originalUrl       String?
  status            GiftStatus @default(AVAILABLE)
  position          Int        @default(0)
  purchasedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  purchasedQuantity Int        @default(0)
  quantity          Int        @default(1)
  event             Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages          EventMessage[]

  @@index([eventId])
  @@index([status])
  @@index([position])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum EventType {
  BABY_SHOWER
  BIRTHDAY
  WEDDING
  BAPTISM
  GENDER_REVEAL
  CHRISTMAS
  OTHER
}

enum GiftStatus {
  AVAILABLE
  PURCHASED
}

enum Gender {
  MALE
  FEMALE
}

enum MessageStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventMessage {
  id         String        @id @default(cuid())
  eventId    String
  giftId     String?
  authorName String?
  content    String
  status     MessageStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gift       Gift?         @relation(fields: [giftId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([giftId])
  @@index([status])
  @@index([createdAt])
}
