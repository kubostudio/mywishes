generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  BABY_SHOWER
  BIRTHDAY
  WEDDING
  BAPTISM
  GRADUATION
  CHRISTMAS
  OTHER
}

enum GiftStatus {
  AVAILABLE
  PURCHASED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  events        Event[]
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Event {
  id            String    @id @default(cuid())
  type          EventType
  name          String
  honoreeName   String
  date          DateTime
  location      String
  description   String?
  coverImageUrl String?
  slug          String    @unique

  creatorId     String
  creator       User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  gifts         Gift[]

  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([creatorId])
  @@index([slug])
}

model Gift {
  id            String     @id @default(cuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name          String
  imageUrl      String?
  brand         String?
  price         Decimal?   @db.Decimal(10, 2)
  currency      String     @default("PEN")
  description   String?
  color         String?
  size          String?
  dimensions    String?
  originalUrl   String?
  status        GiftStatus @default(AVAILABLE)
  quantity          Int        @default(1)
  purchasedQuantity Int       @default(0)
  position      Int        @default(0)

  purchasedAt   DateTime?
  deletedAt     DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([position])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}